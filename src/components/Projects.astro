---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n";
import {
  featuredProjects,
  otherProjects,
  type Project,
} from "../data/projects";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** Envuelve `texto entre backticks` en <code> para resaltar API y columnas. */
function parts(text: string) {
  return text.split(/(`[^`]+`)/g).map((part) => {
    const isCode = part.startsWith("`") && part.endsWith("`") && part.length > 2;
    return { code: isCode ? part.slice(1, -1) : part, isCode };
  });
}

function altFor(p: Project) {
  return lang === "es"
    ? `Captura de pantalla de ${p.title}`
    : `Screenshot of ${p.title}`;
}

const icons: Record<string, string> = {
  cart: "M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6M9 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2M20 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2",
  calendar: "M3 4h18v18H3zM3 10h18M16 2v4M8 2v4",
  chip: "M4 4h16v16H4zM9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3",
  chart: "M3 3v18h18M7 15v3M12 9v9M17 5v13",
  sparkles: "M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9zM19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z",
  sun: "M12 5a7 7 0 1 0 0 14 7 7 0 0 0 0-14M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1",
  gauge: "M12 21a9 9 0 1 1 9-9M12 12l4-4",
};
---

<section class="section" id="projects">
  <div class="container">
    <h2 class="section-title">{t("projects.title")}</h2>
    <p class="section-lead">{t("projects.lead")}</p>

    <div class="features">
      {
        featuredProjects.map((p) => (
          <article class="feature">
            <div class="feature__media">
              {p.image ? (
                <Image
                  src={p.image}
                  alt={altFor(p)}
                  widths={[420, 720]}
                  sizes="(max-width: 760px) 100vw, 420px"
                  class="feature__shot"
                  format="webp"
                  quality={78}
                />
              ) : (
                <div class="feature__placeholder" aria-hidden="true">
                  <svg
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={icons[p.icon]} />
                  </svg>
                </div>
              )}
            </div>

            <div class="feature__body">
              <div class="feature__head">
                <h3 class="feature__title">{p.title}</h3>
                {p.inProgress && (
                  <span class="badge badge--wip">{t("projects.inProgress")}</span>
                )}
              </div>

              <p class="feature__desc">{p.description[lang]}</p>

              <ul class="feature__points">
                {p.highlights.map((h) => (
                  <li>
                    {parts(h[lang]).map((part) =>
                      part.isCode ? <code>{part.code}</code> : part.code
                    )}
                  </li>
                ))}
              </ul>

              <div class="tech">
                {p.tech.map((item) => (
                  <span>{item}</span>
                ))}
              </div>

              <div class="links">
                {p.demo && (
                  <a
                    href={p.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link link--demo"
                  >
                    {t("projects.demo")} ↗
                  </a>
                )}
                <a
                  href={p.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link"
                >
                  {t("projects.code")} ↗
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="more-title">{t("projects.more")}</h3>

    <div class="grid">
      {
        otherProjects.map((p) => (
          <article class="card">
            <div class="card__media">
              {p.image ? (
                <Image
                  src={p.image}
                  alt={altFor(p)}
                  widths={[320, 640]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 320px"
                  class="card__shot"
                  format="webp"
                  quality={75}
                />
              ) : (
                <div class="card__placeholder" aria-hidden="true">
                  <svg
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={icons[p.icon]} />
                  </svg>
                </div>
              )}
            </div>

            <div class="card__body">
              <h4 class="card__title">{p.title}</h4>
              <p class="card__desc">{p.description[lang]}</p>
              <div class="tech">
                {p.tech.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
              <div class="links">
                {p.demo && (
                  <a
                    href={p.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link link--demo"
                  >
                    {t("projects.demo")} ↗
                  </a>
                )}
                <a
                  href={p.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link"
                >
                  {t("projects.code")} ↗
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .feature {
    display: grid;
    grid-template-columns: 420px 1fr;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .feature:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .feature__media {
    background: var(--bg-secondary);
    min-height: 300px;
    display: flex;
    align-items: stretch;
    justify-content: center;
    overflow: hidden;
  }

  .feature__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .feature__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .feature__body {
    padding: 30px;
    display: flex;
    flex-direction: column;
  }

  .feature__head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .feature__title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .badge {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .badge--wip {
    border-color: var(--accent);
    color: var(--accent);
  }

  .feature__desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 18px;
  }

  .feature__points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 22px;
  }

  .feature__points li {
    position: relative;
    padding-left: 18px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .feature__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  :global(code) {
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas,
      monospace;
    font-size: 0.86em;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--text);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .tech span {
    font-size: 0.72rem;
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: 4px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
  }

  .links {
    display: flex;
    gap: 18px;
    margin-top: auto;
  }

  .link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link:hover {
    color: var(--text);
  }

  .link--demo {
    color: var(--accent);
  }

  .link--demo:hover {
    color: var(--accent-hover);
  }

  .more-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 64px 0 24px;
    letter-spacing: -0.01em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }

  .card__media {
    background: var(--bg-secondary);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .card__body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .card__desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 16px;
    flex: 1;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature__media {
      min-height: 200px;
      aspect-ratio: 16 / 9;
    }

    .feature__body {
      padding: 22px;
    }
  }

  @media (max-width: 640px) {
    .more-title {
      margin: 48px 0 20px;
    }
  }
</style>
