---
import { getLangFromUrl, useTranslations, translatePath, langMeta } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const otherLang = lang === "es" ? "en" : "es";
const otherMeta = langMeta[otherLang];
const otherUrl = translatePath(Astro.url.pathname, otherLang);

const links = [
  { href: "#projects", label: t("nav.projects") },
  { href: "#about", label: t("nav.about") },
  { href: "#contact", label: t("nav.contact") },
];

const homeHref = translatePath("/", lang);
---

<header class="nav">
  <div class="container nav__inner">
    <a href={homeHref} class="nav__logo">
      hmoreira<span class="nav__dot">.</span>
    </a>

    <nav class="nav__menu" id="navMenu" aria-label={t("nav.menu")}>
      <ul class="nav__links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li><a href={lang === "es" ? "/cv" : "/en/cv"}>{t("nav.cv")}</a></li>
      </ul>
    </nav>

    <div class="nav__right">
      <a
        href={otherUrl}
        class="nav__lang"
        hreflang={otherMeta.htmlLang}
        lang={otherMeta.htmlLang}
        aria-label={t("nav.lang")}
      >
        {otherMeta.label}
      </a>

      <button
        type="button"
        class="theme-toggle"
        id="themeToggle"
        aria-label={t("nav.theme")}
      >
        <svg
          class="theme-icon theme-icon--sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg
          class="theme-icon theme-icon--moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <button
        type="button"
        class="nav__burger"
        id="navToggle"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="navMenu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: var(--nav-bg);
    backdrop-filter: blur(8px);
    z-index: 100;
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
  }

  .nav__logo {
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .nav__dot {
    color: var(--accent);
  }

  .nav__menu {
    display: flex;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
  }

  .nav__links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .nav__links a:hover {
    color: var(--text);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    transition: all 0.2s ease;
  }

  .nav__lang:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .theme-toggle,
  .nav__burger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .theme-toggle:hover,
  .nav__burger:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .theme-icon {
    position: absolute;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .theme-icon--sun {
    opacity: 1;
    transform: rotate(0deg);
  }

  .theme-icon--moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  [data-theme="light"] .theme-icon--sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  [data-theme="light"] .theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  .nav__burger {
    display: none;
  }

  @media (max-width: 760px) {
    .nav__burger {
      display: flex;
    }

    .nav__menu {
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: 8px 24px 16px;
      display: none;
    }

    .nav__menu[data-open="true"] {
      display: block;
    }

    .nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav__links a {
      display: block;
      padding: 12px 0;
      font-size: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .nav__links li:last-child a {
      border-bottom: 0;
    }
  }
</style>

<script>
  const themeToggle = document.getElementById("themeToggle");
  const html = document.documentElement;

  themeToggle?.addEventListener("click", () => {
    const current = html.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    html.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* almacenamiento no disponible */
    }
  });

  const navToggle = document.getElementById("navToggle");
  const navMenu = document.getElementById("navMenu");

  const setMenu = (open: boolean) => {
    if (!navMenu || !navToggle) return;
    navMenu.setAttribute("data-open", String(open));
    navToggle.setAttribute("aria-expanded", String(open));
  };

  navToggle?.addEventListener("click", () => {
    const open = navMenu?.getAttribute("data-open") === "true";
    setMenu(!open);
  });

  // El menú móvil se cierra al navegar a una sección
  navMenu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setMenu(false));
  });

  // Escape cierra el menú
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
