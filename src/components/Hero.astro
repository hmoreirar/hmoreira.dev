---
import { getLangFromUrl, useTranslations } from "../i18n";
import { person } from "../data/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const facts = [
  {
    label: t("availability.availabilityLabel"),
    value: t("availability.availability"),
    note: null,
  },
  {
    label: t("availability.timezoneLabel"),
    value: t("availability.timezone"),
    note: t("availability.timezoneNote"),
  },
  {
    label: t("availability.englishLabel"),
    value: t("availability.english"),
    note: t("availability.englishNote"),
  },
  {
    label: t("availability.modeLabel"),
    value: t("availability.mode"),
    note: null,
  },
];
---

<section class="hero">
  <div class="container hero__inner">
    <p class="hero__eyebrow">{person.name}</p>

    <h1 class="hero__title">
      {t("hero.role")}
    </h1>

    <p class="hero__desc">
      {t("hero.desc")}
    </p>

    <div class="hero__cta">
      <a href="#projects" class="hero__link hero__link--primary">
        {t("hero.ctaProjects")}
      </a>
      <a href={lang === "es" ? "/cv" : "/en/cv"} class="hero__link">
        {t("hero.ctaCv")}
      </a>
      <a href="#contact" class="hero__link">
        {t("hero.ctaContact")}
      </a>
    </div>

    <dl class="hero__facts">
      {
        facts.map((f) => (
          <div class="hero__fact">
            <dt>{f.label}</dt>
            <dd>
              {f.value}
              {f.note && <span class="hero__fact-note">{f.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-height) + 48px) 0 64px;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__eyebrow {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .hero__title {
    font-size: clamp(1.9rem, 5vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.12;
    margin-bottom: 20px;
    max-width: 18ch;
  }

  .hero__desc {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 620px;
    margin-bottom: 32px;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 56px;
  }

  .hero__link {
    padding: 11px 22px;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    transition: all 0.2s ease;
  }

  .hero__link:hover {
    color: var(--text);
    border-color: var(--text-muted);
    background: var(--bg-secondary);
  }

  .hero__link--primary {
    background: var(--accent-solid);
    border-color: var(--accent-solid);
    color: #fff;
  }

  .hero__link--primary:hover {
    background: var(--accent-solid-hover);
    border-color: var(--accent-solid-hover);
    color: #fff;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    width: 100%;
    max-width: 760px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .hero__fact {
    background: var(--bg-card);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }

  .hero__fact dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .hero__fact dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero__fact-note {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .hero {
      padding: calc(var(--header-height) + 32px) 0 48px;
    }

    .hero__cta {
      margin-bottom: 40px;
    }

    .hero__facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
